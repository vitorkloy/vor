{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VOR",
  "version": "0.1.2",
  "identifier": "com.vitorkloy.vor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "radial",
        "title": "VOR",
        "url": "index.html",
        "width": 440,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "shadow": false,
        "dragDropEnabled": false
      },
      {
        "label": "settings",
        "title": "VOR",
        "url": "settings.html",
        "width": 980,
        "height": 680,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Visual Operations Router",
    "longDescription": "VOR é o Visual Operations Router: uma roda sob o cursor. O botão do meio lança. Arrastar com Shift, Ctrl ou Alt age no arquivo. O marco 1 só tem a roda de lançar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
